{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/us-fundamentals/release-1-issuer-universe.schema.json",
  "title": "Release 1 issuer-universe policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "release",
    "status",
    "filing_start",
    "required_eligibility_fields",
    "supported_forms",
    "accounting_standards",
    "registrant_types",
    "issuer_types",
    "ingestion",
    "release_scope",
    "metric_supported_start_policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release": {
      "const": "1"
    },
    "status": {
      "const": "frozen"
    },
    "filing_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator",
        "value"
      ],
      "properties": {
        "field": {
          "const": "sec_acceptance_datetime"
        },
        "operator": {
          "const": "on_or_after"
        },
        "value": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "required_eligibility_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_forms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "10-K",
          "10-Q",
          "10-K/A",
          "10-Q/A"
        ]
      }
    },
    "accounting_standards": {
      "$ref": "#/$defs/classificationWithoutIndeterminate"
    },
    "registrant_types": {
      "$ref": "#/$defs/classification"
    },
    "issuer_types": {
      "$ref": "#/$defs/classification"
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibility_is_independent",
        "default_status",
        "statuses"
      ],
      "properties": {
        "eligibility_is_independent": {
          "const": true
        },
        "default_status": {
          "type": "string",
          "minLength": 1
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "release_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_sources",
        "explicitly_excluded"
      ],
      "properties": {
        "included_sources": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "explicitly_excluded": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "metric_supported_start_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "later_start_allowed",
        "requires_empirical_quality_evidence",
        "requires_policy_version_increment"
      ],
      "properties": {
        "default": {
          "const": "inherit_release_filing_start"
        },
        "later_start_allowed": {
          "const": true
        },
        "requires_empirical_quality_evidence": {
          "const": true
        },
        "requires_policy_version_increment": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classificationWithoutIndeterminate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "recognized_unsupported"
      ],
      "properties": {
        "included": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "recognized_unsupported": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "recognized_unsupported",
        "indeterminate"
      ],
      "properties": {
        "included": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "recognized_unsupported": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "indeterminate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
